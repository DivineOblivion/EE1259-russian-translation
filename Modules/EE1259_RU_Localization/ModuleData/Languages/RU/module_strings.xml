    <string id="mongol" text="{.MA}Монгол{.nnp}"/>
    <string id="mongoldescription" text="К 1259 году западный монгольский улус — владения Джучидов, позднее получившие название Золотая Орда, — господствовал над Причерноморско-Каспийской степью, управляя из Сарая под властью хана Берке. Они взимали дань с русских князей, отправляли тумены на запад и сохраняли кочевой уклад монгольского народа, основанный на юртах и коневодстве."/>
