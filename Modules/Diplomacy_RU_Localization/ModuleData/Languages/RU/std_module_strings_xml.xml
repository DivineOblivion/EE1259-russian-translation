    <string id="Ckd1Lsoa" text="Расход золота" />
    <string id="t4hNAoD7" text="Включить масштабирование расхода золота" />
    <string id="5MMIDE5A" text="Если включено, расход золота на дипломатические действия и военные репарации будет зависеть от размера вашего королевства. В противном случае для дипломатических действий будет применяться стандартный множитель 100, а для военных репараций — 1000. По умолчанию включено." />
    <string id="vD270X6H" text="Множитель масштабирования расхода золота" />
    <string id="Gd52NzBP" text="Множитель расхода золота с учётом масштабирования. Значение по умолчанию — 5." />
    <string id="HFtZsD6v" text="Множитель масштабирования военных репараций" />
    <string id="MIhbrqbr" text="Множитель расхода золота на военные репарации с учётом масштабирования. Значение по умолчанию — 50." />
    <string id="Cr6a5Jap" text="Стоимость репараций за поражение в войне" />
    <string id="NH4GNKva" text="Базовая сумма репараций в золоте за поражение в войне на истощение против другого королевства. Зависит от масштабирования. Если масштабирование отключено, сумма умножается на 1000. Значение по умолчанию — 200." />

    <string id="SEViwYTl" text="Расход влияния" />
    <string id="WbOKuWbQ" text="Включить расход влияния" />
    <string id="K2vLGalN" text="Если отключено, объявление войны и заключение мира не будут требовать влияния. По умолчанию включено." />
    <string id="9PlT57Nl" text="Расход влияния - Масштабиуемые" />
    <string id="P1g6Ht1e" text="Включить масштабирование расхода влияния" />
    <string id="xfVFBxfj" text="Если включено, расход влияния будет зависеть от размера вашего королевства. В противном случае будет применяться фиксированный расход влияния. По умолчанию включено." />
    <string id="TvAYJv5Q" text="Множитель масштабирования расхода влияния" />
    <string id="AQ5gRYN6" text="Множитель расхода влияния с учётом масштабирования. Значение по умолчанию — 5." />
    <string id="BazjeCZw" text="Расход влияния - Фиксированные" />
    <string id="OnTeAgin" text="Фиксированный расход влияния на объявление войны" />
    <string id="O5XvybTI" text="Количество влияния, необходимое для объявления войны другому королевству. Значение по умолчанию — 500." />
    <string id="iNsXQD2q" text="Фиксированный расход влияния на заключение мира" />
    <string id="WB5zdvdT" text="Количество влияния, необходимое для заключения мира с другим королевством. Значение по умолчанию — 500." />

    <string id="nueOs6m9" text="Гонцы" />
    <string id="nwTyegdV" text="Разрешить происшествия с гонцами" />
    <string id="T7yybpw3" text="Если включено, гонцы могут попасть в неприятности. Чем дольше путь, тем выше вероятность происшествия в дороге. По умолчанию включено." />
    <string id="ysYCYvwT" text="Ограничить отправку гонцов" />
    <string id="5O87pSL3" text="Если включено, вы можете отправлять гонцов только к тем, с кем уже встречались или о ком, скорее всего, слышали. В противном случае вы можете отправить гонца к любому персонажу, независимо от того, знаете ли вы адресата. По умолчанию включено." />
    <string id="nnXi6MmH" text="Время в пути гонца (в днях)" />
    <string id="zkvCGLuK" text="Максимальное время (в днях), за которое гонец может добраться до адресата. Напрямую влияет на скорость передвижения гонцов. Значение по умолчанию — 3." />
    <string id="nMwWHj4h" text="Стоимость отправки гонца" />
    <string id="ehMf7xvE" text="Количество золота для отправки гонца к другому персонажу. Значение по умолчанию — 100." />
    <string id="YolJlw95" text="Минимальная стоимость отправки гонца" />
    <string id="P5NWxY6F" text="Минимальное количество золота для отправки гонца к другому персонажу. Значение по умолчанию — 75." />
    <string id="Hkv9Peqa" text="Стоимость отправки гонца за час пути" />
    <string id="ckYA36t8" text="Количество золота за каждый час, который гонец проведёт в пути до другого персонажа. Значение по умолчанию — 1." />

    <string id="OfEMJWiR" text="Отношения" />
    <string id="6l9QNMrB" text="Множитель улучшения отношений при передаче владения" />
    <string id="FQaghHo7" text="Множитель, определяющий, насколько улучшатся отношения при передаче владений. Значение по умолчанию — 1." />
    <string id="9qKclHq3" text="Ухудшение отношений при передаче владения" />
    <string id="fgc8Dvg0" text="На сколько ухудшатся отношения при передаче владения другому клану. Значение по умолчанию — -2."/>

    <string id="8ZPKToTq" text="Баланс влияния"/>
    <string id="4jlYRUdZ" text="Включить баланс влияния"/>
    <string id="tOMN9DQD" text="Определяет, будут ли действовать механизмы снижения влияния и коррупции. Для совместимости с другими модами может потребоваться отключение этой настройки."/>

    <string id="vzKRX2JA" text="Снижение влияния"/>
    <string id="szYr4OTG" text="Включить снижение влияния" />
    <string id="rKS9z4Sz" text="Включает постепенное ежедневное снижение влияния. По умолчанию включено."/>

    <string id="pVE1yNlm" text="Порог снижения влияния"/>
    <string id="MnLk08uW" text="Количество влияния, не подверженное снижению. Значение по умолчанию — 1000."/>
    <string id="WTeM4Rba" text="Максимальная потеря влияния в день"/>
    <string id="CGixJ6ng" text="Максимальное количество влияния, которое можно потерять за день. Значение по умолчанию — 20."/>
    <string id="yob5ZHtz" text="Ежедневный процент снижения влияния"/>
    <string id="IYFl4kJx" text="Процент влияния, теряемого за день. Значение по умолчанию — 2.0." />

    <string id="e5fHDXgl" text="Коррупция" />
    <string id="KWAH0S4h" text="Включить коррупцию" />
    <string id="trgnZ0pn" text="Включает коррупцию, из-за которой влияние клана постепенно снижается каждый день, если он владеет слишком большим количеством владений. По умолчанию включено."/>

    <string id="ZqQaUIil" text="Экспансионизм"/>
    <string id="2raR1ZHv" text="Коалиции"/>
    <string id="Pr4dcRKm" text="Минимальный уровень экспансионизма за владение"/>
    <string id="9qcAWjI7" text="Минимальное количество очков экспансионизма, которое даёт одно владение. Значение по умолчанию — 3."/>
    <string id="MnhMW8iq" text="Экспансионизм за осаду"/>
    <string id="lCbie62E" text="Количество очков экспансионизма, начисляемых за каждую успешную осаду. Значение по умолчанию — 20."/>
    <string id="mEXGC0h3" text="Ежедневное снижение экспансионизма"/>
    <string id="kgPeQvqE" text="Количество экспансионизма, на которое он снижается каждый день. Значение по умолчанию — 1."/>
    <string id="ZIf1tRII" text="Включить коалиции"/>
    <string id="8v8q0OGu" text="Включает коалиции, позволяющие фракциям объединяться против экспансии другой сильной фракции. По умолчанию включено."/>
    <string id="1kSd88X5" text="Порог экспансионизма"/>
    <string id="EUnASoee" text="Уровень экспансионизма, которого должна достичь фракция, чтобы против неё сформировалась коалиция. Значение по умолчанию — 100."/>
    <string id="zwbL9BHe" text="Ежедневная вероятность формирования коалиции"/>
    <string id="9ugCWA3v" text="Вероятность формирования коалиции против фракции, превысившей порог экспансионизма, в процентах. Значение по умолчанию — 5."/>

    <string id="lsyl0VSX" text="Защита основного сюжета"/>
    <string id="EVrErrTR" text="Если включено, не позволяет игроку нарушить основной сюжет. Отключите при использовании таких модов, как &quot;Just Let Me Play&quot;. По умолчанию включено." />

    <string id="f6n2UAEC" text="Незавершённые функции" />
    <string id="HSoZfvXH" text="Включить возможность узурпации престола" />
    <string id="ZIAo4er4" text="Позволяет игроку узурпировать престол королевства. Эта функция не сбалансирована и ожидает переработки, поэтому её использование не рекомендуется. По умолчанию отключено." />
  </strings>
</base>
